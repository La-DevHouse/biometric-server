# Copiar a .env para desarrollo local (el .env está gitignored).
# Coincide con el docker-compose.yml de este repo.
DATABASE_URL="postgresql://biometric:biometric@localhost:55432/biometric?schema=public"

# Desarrollo contra PRODUCCIÓN (2026-10-18): túnel SSH al Postgres del server,
# p. ej. `ssh -L 5432:<host-de-postgres>:5432 root@<server>`, y
#   DATABASE_URL="postgresql://postgres:<clave>@localhost:5432/postgres?schema=public"
# Ojo: todo lo que se haga en el panel local es real (comandos a equipos
# incluidos), no correr migraciones desde acá y no apuntar equipos a este PC.

# Para tests: base aparte, NUNCA producción. Si DATABASE_URL no es el Postgres de
# Docker (puerto 55432), `npm test` se niega a correr sin esta variable
# (scripts/test-db-setup.ts), porque si no crearía biometric_test en ese server.
# TEST_DATABASE_URL="postgresql://biometric:biometric@localhost:55432/biometric_test?schema=public"

# Puerto del servidor HTTP (ya existente en el proyecto).
# PORT=3000

# Escaneo de cédula/RIF por foto (docs/09-reunion-3.md §3.10) — Gemini Flash,
# tier gratis. Sin esto, el botón de escaneo por foto muestra un error pero el
# resto del panel funciona igual (el RIF por PDF no depende de esto).
# GEMINI_API_KEY="tu-api-key-de-Google-AI-Studio"
# GEMINI_MODEL="gemini-2.5-flash"  # opcional, por si cambia el nombre del modelo

# Solo server de test (Nuremberg): se sirve por HTTP plano y el dominio sslip.io
# no puede tener cert de Let's Encrypt. COOKIE_INSECURE=1 baja el flag `Secure`
# de la cookie de sesión para poder iniciar sesión sobre HTTP.
# NO usar en Ashburn / producción — deja la sesión interceptable en texto claro.
# COOKIE_INSECURE=1
